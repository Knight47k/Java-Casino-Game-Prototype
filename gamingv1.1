    private static long playKeno(long money) {
        long bet = getSafeLong("Bet: $");
        if (bet > money || bet <= 0) return money;
        System.out.println("Pick 10 numbers between 1 and 80:");
        Set<Integer> userPicks = new HashSet<>();
        while (userPicks.size() < 10) {
            int n = getSafeInt("Number: ");
            if (n < 1 || n > 80) System.out.println("Pick 1-80.");
            else userPicks.add(n);
        }
        Set<Integer> winners = new HashSet<>();
        while (winners.size() < 20) winners.add(rand.nextInt(80) + 1);
        int matches = 0;
        for (int p : userPicks) if (winners.contains(p)) matches++;
        System.out.println("Winning Numbers: " + winners + "\nMatches: " + matches);
        if (matches >= 5) {
            long payout = (long)(bet * Math.pow(2, matches - 4));
            System.out.println("WIN! Payout: $" + payout);
            checkAchievements(money + payout, bet, true); return money + payout;
        }
        System.out.println("LOSE!"); checkAchievements(money-bet, bet, false); return money - bet;
    }

    private static long playCraps(long money) {
