import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.security.SecureRandom;
import java.time.LocalDate;
import java.util.*;

/**
 * A small console casino.  Version 1.4 focuses on safe input, predictable
 * money handling, and reliable save files.  This is entertainment only:
 * the save-file checksum is an integrity check, not real security.
 */
class Casino {
    private static final Scanner INPUT = new Scanner(System.in);
    private static final SecureRandom RANDOM = new SecureRandom();
    private static final Path SAVE_FILE = Paths.get("GameSaveData.properties");
    private static final long DEFAULT_MONEY = 100L;
    private static final long MAX_MONEY = 1_000_000_000L;
    private static final String[] SLOTS = {"CHERRY", "LEMON", "BELL", "DIAMOND", "SEVEN"};

    private static final Set<String> achievements = new TreeSet<>();
    private static final Set<Integer> gamesPlayed = new HashSet<>();
    private static String lastClaimDate = "";
    private static int winStreak;

    private static String read(String prompt) {
        while (true) {
            System.out.print(prompt);
            if (!INPUT.hasNextLine()) {
                System.out.println("\nInput closed. Goodbye!");
                System.exit(0);
            }
            String value = INPUT.nextLine().trim();
            if (!value.isEmpty()) return value;
            System.out.println("[!] A value is required.");
        }
    }

    private static long longInput(String prompt, long min, long max) {
        while (true) {
            try {
                long value = Long.parseLong(read(prompt));
                if (value >= min && value <= max) return value;
            } catch (NumberFormatException ignored) { }
            System.out.printf("[!] Enter a whole number from %d to %d.%n", min, max);
        }
    }

    private static int intInput(String prompt, int min, int max) {
        return (int) longInput(prompt, min, max);
    }

    private static String option(String prompt, String... valid) {
        Set<String> allowed = new HashSet<>(Arrays.asList(valid));
        while (true) {
            String value = read(prompt).toLowerCase(Locale.ROOT);
            if (allowed.contains(value)) return value;
            System.out.println("[!] Choose one of: " + String.join(", ", valid));
        }
    }

    private static long bet(long money) {
        return longInput("Bet: $", 1, Math.min(money, MAX_MONEY));
    }

    private static long add(long money, long amount) {
        if (amount < 0 || money > MAX_MONEY - amount) {
            System.out.println("[!] Maximum balance reached.");
            return MAX_MONEY;
        }
        return money + amount;
    }

    private static void result(long money, long bet, boolean won) {
        if (won) {
            winStreak++;
            if (winStreak >= 5) unlock("WINNING STREAK");
        } else winStreak = 0;
        if (bet >= 10_000) unlock("HIGH ROLLER");
        if (money >= 1_000_000) unlock("MILLIONAIRE");
    }

    private static void unlock(String name) {
        if (achievements.add(name)) System.out.println("[ACHIEVEMENT UNLOCKED]: " + name + "!");
    }

    private static String checksum(Properties p) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            String data = p.getProperty("balance", "") + "|" + p.getProperty("date", "")
                    + "|" + p.getProperty("achievements", "");
            byte[] bytes = digest.digest(data.getBytes(StandardCharsets.UTF_8));
            StringBuilder out = new StringBuilder();
            for (byte b : bytes) out.append(String.format("%02x", b));
            return out.toString();
        } catch (NoSuchAlgorithmException e) {
            throw new IllegalStateException("SHA-256 is unavailable", e);
        }
    }

    private static void save(long money) {
        Properties p = new Properties();
        p.setProperty("version", "1.4");
        p.setProperty("balance", Long.toString(Math.max(0, Math.min(money, MAX_MONEY))));
        p.setProperty("date", lastClaimDate);
        p.setProperty("achievements", String.join(",", achievements));
        p.setProperty("checksum", checksum(p));
        Path temp = SAVE_FILE.resolveSibling(SAVE_FILE + ".tmp");
        try (Writer writer = Files.newBufferedWriter(temp, StandardCharsets.UTF_8)) {
            p.store(writer, "Casino save data");
            try {
                Files.move(temp, SAVE_FILE, StandardCopyOption.REPLACE_EXISTING,
                        StandardCopyOption.ATOMIC_MOVE);
            } catch (AtomicMoveNotSupportedException e) {
                Files.move(temp, SAVE_FILE, StandardCopyOption.REPLACE_EXISTING);
            }
        } catch (IOException e) {
            System.err.println("[!] Could not save progress: " + e.getMessage());
        }
    }

    private static long load() {
        if (!Files.exists(SAVE_FILE)) return DEFAULT_MONEY;
        Properties p = new Properties();
        try (Reader reader = Files.newBufferedReader(SAVE_FILE, StandardCharsets.UTF_8)) {
            p.load(reader);
            long money = Long.parseLong(p.getProperty("balance"));
            if (money < 0 || money > MAX_MONEY || !checksum(p).equals(p.getProperty("checksum")))
                throw new IOException("checksum or balance validation failed");
            lastClaimDate = p.getProperty("date", "");
            String saved = p.getProperty("achievements", "");
            if (!saved.isBlank()) achievements.addAll(Arrays.asList(saved.split(",")));
            return money;
        } catch (Exception e) {
            System.out.println("[!] Save data is invalid; starting with $" + DEFAULT_MONEY + ".");
            return DEFAULT_MONEY;
        }
    }

    private static long dailyReward(long money) {
        String today = LocalDate.now().toString();
        if (today.equals(lastClaimDate)) return money;
        long reward = 100 + RANDOM.nextInt(251);
        lastClaimDate = today;
        money = add(money, reward);
        save(money);
        System.out.println("[DAILY REWARD] You received $" + reward + "!");
        return money;
    }

    private static long coinFlip(long money) {
        long b = bet(money); String pick = option("Heads/Tails (h/t): ", "h", "t");
        boolean won = pick.equals(RANDOM.nextBoolean() ? "h" : "t");
        System.out.println(won ? "WIN!" : "LOSE!"); result(won ? add(money, b) : money - b, b, won);
        return won ? add(money, b) : money - b;
    }

    private static long slots(long money) {
        long b = bet(money); String a = SLOTS[RANDOM.nextInt(5)], c = SLOTS[RANDOM.nextInt(5)], d = SLOTS[RANDOM.nextInt(5)];
        System.out.printf("[ %s | %s | %s ]%n", a, c, d);
        long prize = a.equals(c) && c.equals(d) ? b * 10 : (a.equals(c) || c.equals(d) || a.equals(d) ? b * 2 : 0);
        boolean won = prize > 0; result(won ? add(money, prize) : money - b, b, won);
        System.out.println(won ? "WIN! Prize: $" + prize : "No match.");
        return won ? add(money, prize) : money - b;
    }

    private static long higherLower(long money) {
        long b = bet(money); int first = RANDOM.nextInt(6) + 1;
        System.out.println("Roll 1: " + first); String pick = option("Higher/Lower (h/l): ", "h", "l");
        int second = RANDOM.nextInt(6) + 1; System.out.println("Roll 2: " + second);
        if (first == second) return money;
        boolean won = pick.equals("h") ? second > first : second < first;
        result(won ? add(money, b) : money - b, b, won); return won ? add(money, b) : money - b;
    }

    private static long roulette(long money) {
        long b = bet(money); int type = intInput("1 Number, 2 Red/Black, 3 Even/Odd: ", 1, 3);
        int number = -1; String pick = "";
        if (type == 1) number = intInput("Number (0-36): ", 0, 36);
        else pick = type == 2 ? option("Red/Black (r/b): ", "r", "b") : option("Even/Odd (e/o): ", "e", "o");
        int roll = RANDOM.nextInt(37); String color = roll == 0 ? "g" : (roll % 2 == 0 ? "b" : "r");
        boolean won = type == 1 ? roll == number : type == 2 ? pick.equals(color) : roll != 0 && (pick.equals("e") == roll % 2 == 0);
        System.out.println("Result: " + roll + (roll == 0 ? " (green)" : " (" + (color.equals("r") ? "red" : "black") + ")"));
        long prize = type == 1 ? b * 35 : b; result(won ? add(money, prize) : money - b, b, won); return won ? add(money, prize) : money - b;
    }

    private static long blackjack(long money) {
        long b = bet(money); int player = RANDOM.nextInt(11) + 2 + RANDOM.nextInt(11) + 2;
        int dealer = RANDOM.nextInt(11) + 2 + RANDOM.nextInt(11) + 2;
        while (player < 17) { System.out.println("Your total: " + player + " (hitting)"); player += RANDOM.nextInt(11) + 2; }
        while (dealer < 17) dealer += RANDOM.nextInt(11) + 2;
        boolean won = player <= 21 && (dealer > 21 || player > dealer);
        System.out.println("You: " + player + " | Dealer: " + dealer + (won ? " WIN!" : " LOSE!"));
        if (player == dealer && player <= 21) return money;
        result(won ? add(money, b) : money - b, b, won); return won ? add(money, b) : money - b;
    }

    private static long simpleGame(long money, String name, int payout) {
        long b = bet(money); boolean won = RANDOM.nextInt(2) == 0;
        System.out.println(name + (won ? ": WIN!" : ": LOSE!"));
        long prize = b * payout; result(won ? add(money, prize) : money - b, b, won); return won ? add(money, prize) : money - b;
    }

    private static void showMenu(long money) {
        System.out.println("\nBalance: $" + money + " | Achievements: " + achievements.size());
        System.out.println("1 Coin Flip  2 Slots  3 Higher/Lower  4 Blackjack  5 Roulette");
        System.out.println("6 Baccarat   7 Video Poker  8 Horse Racing  9 Keno  10 Craps");
        System.out.println("11 Achievements  12 Save & Exit");
    }

    public static void main(String[] args) {
        long money = dailyReward(load());
        System.out.println("*** WELCOME TO THE JAVA CASINO ***");
        while (true) {
            showMenu(money);
            int choice = intInput("Choose: ", 1, 12);
            if (choice == 12) { save(money); System.out.println("[System] Progress saved."); return; }
            if (choice == 11) { System.out.println(achievements.isEmpty() ? "No achievements yet." : achievements); continue; }
            gamesPlayed.add(choice);
            money = switch (choice) {
                case 1 -> coinFlip(money);
                case 2 -> slots(money);
                case 3 -> higherLower(money);
                case 4 -> blackjack(money);
                case 5 -> roulette(money);
                case 6 -> simpleGame(money, "Baccarat", 1);
                case 7 -> simpleGame(money, "Video Poker", 2);
                case 8 -> simpleGame(money, "Horse Racing", 4);
                case 9 -> simpleGame(money, "Keno", 8);
                default -> simpleGame(money, "Craps", 1);
            };
            if (gamesPlayed.size() == 10) unlock("CASINO TOURIST");
            save(money);
            if (money == 0) { System.out.println("You are broke. Goodbye!"); return; }
        }
    }
}
